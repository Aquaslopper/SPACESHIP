201 RCDATA "title.jpg"

#include <windows.h>
202 DIALOGEX 0, 0, 250, 112
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Load a voyage"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Choose one of your three independent save slots.", -1, 12, 12, 226, 20
  COMBOBOX 110, 12, 36, 226, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "LOAD VOYAGE", IDOK, 12, 80, 110, 22
  PUSHBUTTON "BACK", IDCANCEL, 128, 80, 110, 22
END
203 DIALOGEX 0, 0, 250, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Options - audio"
FONT 9, "Segoe UI"
BEGIN
  CONTROL "Ambient soundtrack", 111, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 226, 18
  CONTROL "Sound effects", 112, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 36, 226, 18
  LTEXT "Audio level", -1, 12, 64, 70, 16
  COMBOBOX 113, 88, 60, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "APPLY", IDOK, 12, 106, 110, 22
  PUSHBUTTON "BACK", IDCANCEL, 128, 106, 110, 22
END
